# Database — Postgres (Neon via Vercel → Storage). Copy both URLs from the Neon integration.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Photo storage — Vercel Blob (Vercel → Storage → Blob). Leave empty to store photos in ./uploads locally.
# BLOB_ACCESS must match the store: "private" (default) or "public".
BLOB_READ_WRITE_TOKEN=""
BLOB_ACCESS="private"

# Public URL of the app (used for OAuth redirects and webhooks)
APP_URL="http://localhost:3000"

# Claude API — AI meal photo scanning and "describe your meal" logging
ANTHROPIC_API_KEY=""

# USDA FoodData Central (free key: https://fdc.nal.usda.gov/api-key-signup). DEMO_KEY works with low limits.
USDA_API_KEY="DEMO_KEY"

# Strava (https://www.strava.com/settings/api) — callback domain: localhost
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_WEBHOOK_VERIFY_TOKEN="violi-strava"

# Garmin Connect Developer Program (requires approval: https://developer.garmin.com/gc-developer-program/)
GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""
